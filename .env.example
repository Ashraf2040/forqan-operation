# Copy the Session pooler URL (port 5432) from Supabase → Connect.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# استخدم قيماً قوية وفريدة في بيئة النشر.
AUTH_SECRET="generate-a-long-random-secret"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password-of-12-characters-or-more"
INITIAL_ADMIN_NAME="مشرف المنصة"

# Hostinger VPS file storage (use an SFTP-only user/key with access to this folder)
HOSTINGER_SFTP_HOST="your-vps-ip-or-hostname"
HOSTINGER_SFTP_PORT="22"
HOSTINGER_SFTP_USER="evidence-storage-user"
HOSTINGER_SFTP_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# Keep this outside any public web root, e.g. /home/evidence-storage-user/evidence
HOSTINGER_EVIDENCE_DIR="/home/evidence-storage-user/evidence"
